# API base URL
VITE_API_BASE_URL=your_api_base_url # Eg: http://localhost:3000

# reCAPTCHA app site key
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key # Eg: 6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI (This is a test key provided by Google for testing purposes.)

# Socket server URL
VITE_SOCKET_SERVER_URL=your_socket_server_url # Eg: http://localhost:3000