# Database connection string
DATABASE_URL="postgresql://username:randompassword@localhost:5432/mydb?schema=public"

# Node environment
NODE_ENV=your_environment

# reCAPTCHA secret key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Logs directory
LOGS_DIR=../logs

# JWT Configuration
# IMPORTANT: Generate secure random secrets for production using:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Run the command TWICE to get two different secrets (one for JWT_SECRET, one for JWT_REFRESH_SECRET)

# Access Token (short-lived, sent with every API request)
JWT_SECRET="CHANGE_ME_your-128-character-random-hex-secret-generate-using-command-above"
JWT_EXPIRES_IN="1h"

# Refresh Token (long-lived, stored in database, used to get new access tokens)
# MUST be different from JWT_SECRET for security isolation
JWT_REFRESH_SECRET="CHANGE_ME_your-different-128-character-random-hex-secret-generate-using-command-above"
JWT_REFRESH_EXPIRES_IN="30d"