// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int                @id @default(autoincrement())
  fullname          String
  email             String             @unique
  password          String
  role              UserRole
  phone             String?
  address           String?
  profilePicture    String?
  ratings           Float? // average rating
  rides             Ride[]             @relation("RiderRides")
  rideRequests      RideRequest[]
  messages          Message[]          @relation("UserMessages")
  passengerRides    Ride[]             @relation("RidePassengers")
  createdRides      Ride[]             @relation("CreatedUser")
  ratingsGiven      Rating[]           @relation("FromUser")
  ratingsReceived   Rating[]           @relation("ToUser")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  karmaPoints       Int                @default(0) // Total karma points
  creditScore       Int                @default(0) // Total credit score for passengers
  karmaTransactions KarmaTransaction[]
  feedbackGiven     Feedback[]         @relation("FromUser")
  feedbackReceived  Feedback[]         @relation("ToUser")
  refreshTokens     RefreshToken[] // JWT refresh tokens
  tripsAsRider      Trip[]             @relation("TripRider")
  tripsAsPassenger  Trip[]             @relation("TripPassenger")
}

/// A refresh token, stored only as a hash.
///
/// `familyId` groups every token descended from one login. Rotation issues a
/// new token and revokes the old one, so a token presented twice means the
/// value leaked -- and the whole family is revoked rather than just that row.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  familyId  String
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model Ride {
  id                     Int           @id @default(autoincrement())
  from                   String
  fromLat                Float?
  fromLng                Float?
  to                     String
  toLat                  Float?
  toLng                  Float?
  message                String?
  role                   UserRole
  timestamp              DateTime      @default(now())
  createdBy              Int // ID of user who created the ride (could be passenger or rider)
  createdByUser          User          @relation("CreatedUser", fields: [createdBy], references: [id])
  rider                  User?         @relation("RiderRides", fields: [riderId], references: [id])
  estimatedTimeOfArrival Int? // ETA in minutes
  riderId                Int? // Made optional since it can be null for passenger-created rides
  passengerId            Int? // ID of the passenger who requested the ride (if applicable)
  requests               RideRequest[]
  passengers             User[]        @relation("RidePassengers")
  ratings                Rating[]
  messages               Message[]
  feedback               Feedback[]
  status                 RideStatus    @default(ACTIVE)
  distance               Float? // Distance in kilometers, calculated when ride is confirmed
  co2Saved               Float? // CO2 saved in kg
  peopleImpacted         Int? // Number of people impacted (passengers)
  matchGroupId           String? // UUID to group matched rides together

  // Public listings and the matcher both filter on status and then order or
  // window on timestamp, so this pair carries the hottest read path.
  @@index([status, timestamp])
  // "Does this user already have an open ride?" on every ride creation.
  @@index([createdBy, status])
  // Ride history: the three OR'd ownership lookups.
  @@index([riderId])
  @@index([passengerId])
  // Grouping the two rows that make up one matched trip.
  @@index([matchGroupId])
}

/// The two sides of a shared commute. Values are lowercase to match the
/// USER_ROLE enum the application already uses.
enum UserRole {
  rider
  passenger
}

/// A matched journey: the thing that actually happens once two postings pair
/// up.
///
/// A `Ride` is an *intent* to travel. Until now the matched journey had no
/// representation of its own -- it was two Ride rows sharing a `matchGroupId`,
/// with status, distance and CO2 duplicated across both. Every query that
/// asked "how many trips has this user taken" therefore had to collapse those
/// pairs first, which is why the same COALESCE(matchGroupId, ...) expression
/// appeared in three separate services.
///
/// Modelled as exactly one rider and one passenger. That is what the product
/// already assumes everywhere: each code path reads `passengers[0]`, and the
/// UI describes one passenger per bike. Group rides would need this widened.
model Trip {
  id             Int        @id @default(autoincrement())
  /// Links back to the Ride rows this was derived from, while both models coexist.
  matchGroupId   String     @unique
  riderId        Int
  passengerId    Int
  rider          User       @relation("TripRider", fields: [riderId], references: [id])
  passenger      User       @relation("TripPassenger", fields: [passengerId], references: [id])
  status         RideStatus
  from           String
  to             String
  timestamp      DateTime
  distance       Float?
  co2Saved       Float?
  peopleImpacted Int?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([riderId, status])
  @@index([passengerId, status])
}

enum RideStatus {
  IDLE
  ACTIVE
  CONFIRMED
  REJECTED
  EXPIRED
  CANCELLED
  COMPLETED
}

model RideRequest {
  id          Int      @id @default(autoincrement())
  ride        Ride     @relation(fields: [rideId], references: [id])
  rideId      Int
  passenger   User     @relation(fields: [passengerId], references: [id])
  passengerId Int
  status      String // pending, accepted, rejected
  createdAt   DateTime @default(now())
}

model Rating {
  id         Int      @id @default(autoincrement())
  ride       Ride     @relation(fields: [rideId], references: [id])
  rideId     Int
  fromUser   User     @relation("FromUser", fields: [fromUserId], references: [id])
  fromUserId Int
  toUser     User     @relation("ToUser", fields: [toUserId], references: [id])
  toUserId   Int
  score      Int
  comment    String?
  createdAt  DateTime @default(now())
}

model Message {
  id        Int      @id @default(autoincrement())
  content   String
  sender    User     @relation("UserMessages", fields: [senderId], references: [id])
  senderId  Int
  ride      Ride?    @relation(fields: [rideId], references: [id])
  rideId    Int?
  createdAt DateTime @default(now())
}

model KarmaTransaction {
  id             Int               @id @default(autoincrement())
  user           User              @relation(fields: [userId], references: [id])
  userId         Int
  points         Int
  type           String
  reason         String?
  rewardName     String?
  redemptionCode String?
  status         RedemptionStatus?
  expiresAt      DateTime?
  usedAt         DateTime?
  createdAt      DateTime          @default(now())
}

model Feedback {
  id         Int      @id @default(autoincrement())
  ride       Ride     @relation(fields: [rideId], references: [id])
  rideId     Int
  fromUser   User     @relation("FromUser", fields: [fromUserId], references: [id])
  fromUserId Int
  toUser     User     @relation("ToUser", fields: [toUserId], references: [id])
  toUserId   Int
  role       UserRole // role of the person giving feedback
  emoji      Int // emoji reaction index: 0=😊, 1=😐, 2=😠
  comment    String? // optional comment
  createdAt  DateTime @default(now())

  @@unique([rideId, fromUserId, toUserId]) // Prevent duplicate feedback
}

enum RedemptionStatus {
  ACTIVE
  USED
  EXPIRED
  LOCKED
}
